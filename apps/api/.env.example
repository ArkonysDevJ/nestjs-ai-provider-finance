# ── Supabase ────────────────────────────────────────────────────
# Public URL of the Supabase project.
SUPABASE_URL=https://your-project.supabase.co
# Publishable/anon key — safe to expose to the backend (RLS protects it).
# Never the service_role key: the backend operates with the user's JWT,
# not an admin client. See common/guards/supabase-auth.guard.ts.
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ── AI Provider ─────────────────────────────────────────────────
# gemini | local — selects the AIProvider implementation without
# touching code (see ai/ai-provider.factory.ts).
AI_PROVIDER=gemini

# Required only if AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key

# Required only if AI_PROVIDER=local. URL of the real MCP server
# (streamable-http, NOT a REST endpoint) -- see finance-classifier-mcp,
# a separate project that runs Ollama locally. FastMCP's default path: /mcp.
LOCAL_AI_ENDPOINT=http://localhost:8765/mcp

# ── App ─────────────────────────────────────────────────────────
PORT=3000
