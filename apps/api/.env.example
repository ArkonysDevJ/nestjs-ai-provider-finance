# ── Supabase ────────────────────────────────────────────────────
# Public URL of the Supabase project.
SUPABASE_URL=https://your-project.supabase.co
# Publishable/anon key — safe to expose to the backend (RLS protects it).
# Never the service_role key: the backend operates with the user's JWT,
# not an admin client. See common/guards/supabase-auth.guard.ts.
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ── AI Provider ─────────────────────────────────────────────────
# gemini | local — selects the AIProvider implementation without touching
# code (see ai/ai.module.ts). Any other value stops startup. "local" is for
# development only and stops startup when NODE_ENV is "production".
AI_PROVIDER=gemini

# Required only if AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
# The exact model name. A "-latest" alias is not accepted.
GEMINI_MODEL=your-gemini-model-name

# Time limit of one provider call, in milliseconds. Default 10000, maximum
# 50000 (the platform request limit is 60 seconds).
# AI_TIMEOUT_MS=10000

# Required only if AI_PROVIDER=local. URL of the real MCP server
# (streamable-http, NOT a REST endpoint) -- see finance-classifier-mcp,
# a separate project that runs Ollama locally. FastMCP's default path: /mcp.
LOCAL_AI_ENDPOINT=http://localhost:8765/mcp

# ── App ─────────────────────────────────────────────────────────
PORT=3000

# Origins that may call the API from a browser: exact origins, comma
# separated. Without this variable no cross-origin request is allowed, so the
# web app in development needs its own origin here.
CORS_ORIGINS=http://localhost:5173

# Rate limiter, per client address. If any of the four is missing the limiter
# is inactive, which is what development usually wants (they are commented out).
# With one proxy in front, as in Cloud Run, the client address is the last entry
# of X-Forwarded-For; with no proxy in front it is the address of the socket.
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_MAX=120
# RATE_LIMIT_HEALTH_MAX=30
# RATE_LIMIT_TRUSTED_PROXY_HOPS=1
