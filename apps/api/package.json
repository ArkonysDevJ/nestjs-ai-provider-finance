{
  "name": "@nestjs-ai-provider-finance/api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend: NestJS + Supabase + AI provider abstraction (Gemini/local).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "build": "nest build",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.{ts,cjs}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.{ts,cjs}\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:dev:gemini": "cross-env AI_PROVIDER=gemini nest start --watch",
    "start:dev:local": "cross-env AI_PROVIDER=local nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.{ts,cjs}\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.{ts,cjs}\" --fix"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nestjs/common": "^12.3.3",
    "@nestjs/config": "^12.1.0",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-fastify": "^12.3.3",
    "@nestjs/throttler": "^6.7.1",
    "@supabase/supabase-js": "^2.45.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.5.0",
    "cross-env": "^7.0.3",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.5.4"
  }
}
