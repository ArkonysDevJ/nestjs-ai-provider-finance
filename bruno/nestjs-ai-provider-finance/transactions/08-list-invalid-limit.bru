meta {
  name: 08 - List Transactions, invalid limit
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/transactions?limit=0
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

assert {
  res.status: eq 400
}

docs {
  A limit outside 1 to 200, or an offset below 0, is a 400. The default limit
  of 100 applies only when the parameter is absent.
}
