meta {
  name: 05 - Invalid Amount
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/transactions
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:json {
  {
    "description": "Invalid amount check",
    "amount": 12.345,
    "type": "expense"
  }
}

docs {
  AC-6 of the error mapping spec: an amount with more than two decimals is
  rejected before anything reaches the database, with 400. The same applies to
  an amount above 9999999999.99, the largest value of numeric(12,2).
}

assert {
  res.status: eq 400
}
