meta {
  name: 01 - Create Transaction
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/transactions
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:json {
  {
    "description": "Almuerzo familiar",
    "amount": 24.00,
    "type": "expense"
  }
}

assert {
  res.status: eq 201
  res.body.ai_classified: eq true
  res.body.ai_provider: isDefined
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar("last_transaction_id", res.body.id);
  }
}
